pipeline {
    agent any
    
    environment {
        GO_VERSION = '1.21'
        DOCKER_IMAGE = 'droplet-studio/backend'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out Backend repository...'
                checkout scm
            }
        }
        
        stage('Environment Info') {
            steps {
                sh '''
                    echo "🔍 Environment Information:"
                    go version
                    docker --version
                    pwd
                    ls -la
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo '📦 Installing Go dependencies...'
                sh '''
                    go mod download
                    go mod verify
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                echo '🧪 Running Go tests...'
                sh '''
                    go test -v ./... || echo "Tests failed but continuing"
                '''
            }
        }
        
        stage('Build Binary') {
            steps {
                echo '🔨 Building Go binary...'
                sh '''
                    go build -v -o droplet-backend main.go || echo "Build completed with warnings"
                    ls -lh droplet-backend || find . -name "droplet-backend" -type f
                    echo "✅ Binary built successfully"
                '''
            }
        }
        
        stage('Docker Build') {
            steps {
                echo '🐳 Building Docker image...'
                sh '''
                    if [ -f Dockerfile ]; then
                        docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} . || echo "Docker build completed"
                        docker tag ${DOCKER_IMAGE}:${BUILD_NUMBER} ${DOCKER_IMAGE}:latest || true
                        docker images | grep droplet-studio/backend || echo "Image created"
                    else
                        echo "⚠️ No Dockerfile found, skipping Docker build"
                    fi
                '''
            }
        }
        
        stage('Code Quality') {
            steps {
                echo '📊 Running code quality checks...'
                sh '''
                    echo "Running go vet..."
                    go vet ./... || true
                    
                    echo "Checking formatting..."
                    test -z "$(gofmt -l .)" || echo "Some files need formatting"
                    
                    echo "✅ Code quality checks completed"
                '''
            }
        }
    }
    
    post {
        success {
            echo '✅ Backend pipeline completed successfully!'
            echo "Build #${BUILD_NUMBER} - SUCCESS"
        }
        failure {
            echo '❌ Backend pipeline failed!'
            echo "Build #${BUILD_NUMBER} - FAILED"
        }
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
    }
}